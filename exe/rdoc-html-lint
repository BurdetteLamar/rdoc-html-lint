#!/usr/bin/env ruby


require_relative "../lib/rdoc/html/lint"

require 'optparse'

options = {}

OptionParser.new do |parser|
  parser.banner = 'Usage: rdoc-html-lint [options]'

  parser.on('-r', '--fetch', 'Fetch each page from the Ruby documentation site.') do
    options[:fetch] = true
  end

  parser.on('-p', '--evaluate', 'Evaluate each page.') do
    options[:evaluate] = true
  end

  parser.on('-c', '--check', 'Check links and headers.') do
    options[:check] = true
  end

  parser.on('-v', '--verbose', 'Enable verbose output.') do
    options[:verbose] = true
  end

  parser.on('-h', '--help', 'Show this help.') do
    puts parser
    exit
  end

end.parse!

checker = Rdoc::Html::Lint::Checker.new
checker.fetch if options[:fetch]
checker.evaluate if options[:evaluate]
checker.check if options[:check]
