#!/usr/bin/env ruby


require_relative "../lib/rdoc/html/lint"

require 'optparse'

options = {}

OptionParser.new do |parser|
  parser.banner = 'Usage: rdoc-html-lint [options]'

  parser.on('-d', '--download', 'Downlload each page from the Ruby documentation site.') do
    options[:download] = true
  end

  parser.on('-e', '--evaluate', 'Evaluate each page.') do
    options[:evaluate] = true
  end

  parser.on('-r', '--report', 'Build report for each page.') do
    options[:report] = true
  end

  parser.on('-v', '--verbose', 'Enable verbose output.') do
    options[:verbose] = true
  end

  parser.on('-h', '--help', 'Show this help.') do
    puts parser
    exit
  end

end.parse!

checker = Rdoc::Html::Lint::Checker.new(options)
